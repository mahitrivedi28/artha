# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME=ARTHA
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (production/dev). Example: postgresql+asyncpg://artha:artha@localhost:5432/artha
DATABASE_URL=postgresql+asyncpg://artha:artha@localhost:5432/artha

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
VAULT_UNLOCK_MINUTES=15

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Phase 5 — leave blank to run without AI (goal-plan/chat/categorize return 503, everything else works normally)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Phase 6 — Vault file storage. UPLOAD_FOLDER can be relative (to backend/) or an absolute path.
UPLOAD_FOLDER=vault_storage
MAX_CONTENT_LENGTH=10485760

# Phase 8 — real email delivery. Leave SMTP_HOST blank to run in dev mode
# (OTP/reset codes and security alerts are printed to the console instead
# of emailed — everything still works end to end, just not delivered).
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App
# Password (not your real password) for SMTP_PASSWORD.
# Example for a free dev/test inbox: Mailtrap or Ethereal both work as
# drop-in SMTP_HOST/PORT/USERNAME/PASSWORD values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@artha.app
SMTP_FROM_NAME=ARTHA

# Encrypts TOTP 2FA secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local dev (a fallback key is derived from JWT_SECRET). A real
# deployment MUST set this explicitly, and separately from JWT_SECRET — they do
# different jobs, and rotating one shouldn't silently invalidate the other.
APP_ENCRYPTION_KEY=

# Background jobs (app/scheduler.py). Off by default so the test suite never
# has cron jobs firing mid-run. Set true in deployment to enable:
#   - daily 00:15 — convert due subscriptions into real expenses
#   - daily 09:00 — budget/goal alert checks (no longer dependent on page loads)
#   - Mondays 09:05 — weekly spending digest notification
# NOTE: this is an in-process scheduler. With multiple Uvicorn workers, every
# worker fires every job. The jobs are idempotent so damage is bounded, but a
# scaled deployment should run the scheduler as one separate process.
SCHEDULER_ENABLED=false
