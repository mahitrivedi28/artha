# LOCAL BEGINNER SETUP — ready to run, no PostgreSQL or email needed.
# Your data is stored in backend/artha_local.db (SQLite file).
# For a real/production deployment, follow backend/.env.example instead.
APP_NAME=ARTHA
ENVIRONMENT=development
DEBUG=true

# Local beginner setup: SQLite file database (NO PostgreSQL install needed)
DATABASE_URL=sqlite+aiosqlite:///./artha_local.db

# Any long random text works for local testing
JWT_SECRET=local-dev-secret-change-me-1234567890

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
VAULT_UNLOCK_MINUTES=15

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Leave blank = AI features off, everything else works
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_FOLDER=vault_storage
MAX_CONTENT_LENGTH=10485760

# Leave blank = OTP codes print to the console instead of being emailed
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@artha.app
SMTP_FROM_NAME=ARTHA

APP_ENCRYPTION_KEY=

SCHEDULER_ENABLED=false
